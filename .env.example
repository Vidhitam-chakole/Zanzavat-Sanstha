# ==============================================================================
# Zanzavat Bahuudeshiya Shaikshanik Sanstha - Environment Variables Template
# Copy this file to .env for local development or configure in Vercel Dashboard.
# DO NOT commit the .env file with real secrets to source control.
# ==============================================================================

# Supabase Database Configuration (Required for cloud persistence)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key

# Email Notifications (Flask-Mail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# AI Assistant Chatbot (Groq API)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

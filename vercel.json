{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/register", "dest": "/api/register.py" },
    { "src": "/api/contact", "dest": "/api/contact.py" },
    { "src": "/api/chat", "dest": "/api/chat.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
